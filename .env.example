# Bu dosya yalnızca hangi değişkenlerin gerektiğini gösterir.
# GERÇEK DEĞERLER BURAYA YAZILMAZ. Değerleri şu komutla çekin:
#
#   vercel env pull .env.local
#
# .env.local dosyası .gitignore içindedir ve asla commit edilmez.

# --- Neon Postgres (Vercel Marketplace tarafından sağlanır) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Payload CMS ---
# Oturum ve token imzalama anahtarı. Rastgele 32 bayt:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Vercel Blob (public store: tubaatman-public) ---
# DİKKAT: BLOB_STORE_ID tanımlamayın. VERCEL_OIDC_TOKEN ile birlikte
# bulunduğunda SDK OIDC yoluna geçer ve yanlış store'a yazabilir.
BLOB_READ_WRITE_TOKEN=

# --- iyzico (Faz 4) ---
# Sandbox: https://sandbox-api.iyzipay.com
# Üretim:  https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- Resend (Faz 5) ---
RESEND_API_KEY=

# --- Site ---
# Mutlak URL üretimi için (canonical, OG görselleri, iyzico callbackUrl)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
